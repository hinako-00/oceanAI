# Anthropic API キー（https://console.anthropic.com/ で発行）
ANTHROPIC_API_KEY=sk-ant-...

# 使用モデル（省略時は claude-opus-5）
# 例: claude-opus-5 / claude-sonnet-5
ANTHROPIC_MODEL=claude-opus-5

# 応答の最大トークン数（省略時は 8000）
ANTHROPIC_MAX_TOKENS=8000

# データ保存先ディレクトリ（省略時は ./data）
DATA_DIR=./data

# ログインCookieに Secure 属性を付けるか（省略時は本番で自動的にtrue）。
# HTTPSでない環境ではブラウザがCookieを保存できずログインできなくなるため、
# 閉じた社内LANでの一時検証など、やむを得ない場合に限り false にする。
# 詳細は DEPLOY.md の「なぜHTTPSが必要か」を参照。
# COOKIE_SECURE=false

# ---- 以下は docker compose 使用時のみ必要（DEPLOY.md 参照） ----
# 公開するドメイン名。CaddyがLet's Encryptの証明書を自動取得する際に使う。
# OCEAN_DOMAIN=ocean.example.com
# 証明書の期限が近いときの通知先メールアドレス。
# OCEAN_TLS_EMAIL=admin@example.com
